{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ls *)",
      "Bash(npx astro *)",
      "Bash(npx wrangler deploy --dry-run)",
      "Bash(npx wrangler types)",
      "Bash(npx wrangler types *)",
      "Bash(npx wrangler whoami)",
      "Bash(npx wrangler whoami *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(npm run deploy)",
      "Bash(npm run deploy *)",
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler delete *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
